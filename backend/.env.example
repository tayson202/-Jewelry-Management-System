# 3M Dahab OS - Environment Configuration
PROJECT_NAME="3M Dahab OS"
ENVIRONMENT="production"  # Options: production, staging, development
API_V1_STR="/api/v1"
SECRET_KEY="REPLACE_WITH_GENERATED_OPENSSL_RAND_HEX_32_IN_PRODUCTION"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection (Defaults to SQLite for standalone gold shop execution, or PostgreSQL for clustered multi-counter)
DATABASE_URL="sqlite:///./stockpilot.db"
# DATABASE_URL="postgresql://dahab_user:dahab_password@localhost:5432/dahab_os_db"

# Gold Desk Defaults (Cairo Sagha Benchmark)
DEFAULT_CURRENCY="EGP"
DEFAULT_24K_BASE_RATE=3420.00
DEFAULT_TAX_RATE_ON_MAKING=0.14

# Optional: Initial Admin Seed Credentials (only used if running python -m app.init_production)
# ADMIN_EMAIL="owner@3mdahab.com"
# ADMIN_PASSWORD="SuperSecurePassword123!"
# ADMIN_NAME="Shop Owner"
# ADMIN_PIN="1234"

