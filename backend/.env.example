# StockPilot (AURUM OS) Backend Configuration
PROJECT_NAME="StockPilot - Gold & Jewelry Management System (AURUM OS)"
API_V1_STR="/api/v1"
SECRET_KEY="AURUM_PRODUCTION_SECRET_KEY_REPLACE_WITH_OPENSSL_RAND_HEX_32"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection (Defaults to SQLite for instant zero-dependency run, or PostgreSQL for Production)
DATABASE_URL="sqlite:///./stockpilot.db"
# DATABASE_URL="postgresql://aurum_user:aurum_password@localhost:5432/stockpilot_db"

# Gold Desk Defaults
DEFAULT_CURRENCY="EGP"
DEFAULT_24K_BASE_RATE=3420.00
DEFAULT_TAX_RATE_ON_MAKING=0.14
